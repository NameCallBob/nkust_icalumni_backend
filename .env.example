# 複製為 .env 並填入實際值。.env 已在 .gitignore 中，切勿提交真實密鑰。

# ── 加密 ──
SECRET_KEY=change-me-to-a-long-random-string
# 選填：JWT 簽章金鑰，未設定則沿用 SECRET_KEY
JWT_SIGNING_KEY=

# ── SQL 資料庫 ──
SERVER_DATABASE=nkust_icalumni
SERVER_USER=
SERVER_PWD=
# 本機開發請用 127.0.0.1，用 localhost 會導致 mysqlclient 嘗試連線不存在的 unix socket
SERVER_IP=127.0.0.1
SERVER_PORT=3306

# ── 寄信 ──
# 主要通道：Resend API
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.org
# 備援：SMTP
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── 部署／網域 ──
# 測試用 IP
TEST_SERVER_IP=
# 實際部署 IP
PRODUCTION_SERVER_IP=

# ── 管理員資訊 ──
ADMIN_NAME=
ADMIN_EMAIL=

# ── 資安相關開關（正式環境請檢視每一項）──
# Swagger/Redoc 是否對外開放（正式環境預設關閉）
EXPOSE_API_DOCS=0
# 是否允許任意 port 的 localhost/127.0.0.1 CORS 來源（僅供本機開發）
ENABLE_DEV_ORIGINS=0
# 是否啟用 HSTS / Secure Cookie 等（已有 HTTPS 的正式部署請設為 1）
ENABLE_HTTPS_SECURITY=0
# 反向代理層數，用於正確解析 X-Forwarded-For
TRUSTED_PROXY_COUNT=0

# ── 開發用種子資料（seed_demo）──
SEED_DEMO_PASSWORD=
ALLOW_SEED_DEMO=0
